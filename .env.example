# Auth.js（npx auth secret で生成）
AUTH_SECRET=

# Google（Google Cloud の OAuth クライアント）
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# LINE（LINE Developers の LINEログイン チャネル。コールバック URL は <サイトのURL>/api/auth/callback/line）
AUTH_LINE_ID=
AUTH_LINE_SECRET=

# Microsoft（Outlook 連携のみ。Entra のアプリ登録は「個人用 Microsoft アカウントのみ」。コールバック URL は <サイトのURL>/api/auth/callback/microsoft-entra-id）
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=

# メールのログインリンク（Gmail のアプリパスワード）
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM="ぽちぷりーず <you@gmail.com>"

# Claude API（回答のAI下書き。無ければルールで埋める）
ANTHROPIC_API_KEY=

# Supabase（Transaction pooler 6543 / Session pooler 5432）
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"

# ローカル開発（Supabase の代わりに npx prisma dev -d --name pochiplease を使う場合は、表示された URL に &connection_limit=1&pgbouncer=true を付けて両方に入れる）
# 開発用ログインと仮の予定データ（本番では入れない）
DEV_LOGIN=1
DEV_FAKE_CALENDAR=1
